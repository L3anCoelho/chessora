# Copie para .env.local e preencha. Todas as variáveis VITE_ ficam visíveis no navegador:
# NUNCA coloque aqui a service_role key do Supabase nem segredos de checkout.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Checkout externo do e-book (ex.: link de pagamento da Kiwify).
# Enquanto vazio, a página do e-book informa que o produto ainda não está à venda.
VITE_CHECKOUT_URL=
# Parâmetro da URL de checkout que leva o ID da conta. A Kiwify devolve "src" no webhook (TrackingParameters).
VITE_CHECKOUT_REF_PARAM=src
# Preço exibido, em centavos (ex.: 4790 = R$ 47,90). Vazio = "preço a definir".
VITE_EBOOK_PRICE_CENTS=
